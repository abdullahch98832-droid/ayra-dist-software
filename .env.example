# Copy to .env.local and fill in. Never commit real values. See docs/SUPABASE_SETUP.md.

# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# App URL used in invitation and password reset emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: true shows the vendor screens again (goods bought from other companies than Ayra)
# NEXT_PUBLIC_OTHER_VENDORS=true

# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
